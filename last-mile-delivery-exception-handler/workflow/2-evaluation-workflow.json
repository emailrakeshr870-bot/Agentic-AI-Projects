      "id": "f4974a04-e4d5-4954-a86e-c6bc6d2d630f",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "// Single evaluation pass over ALL shipment predictions.\nconst preds = $input.all().map(i => i.json);\nconst per = [];\nlet tcN=0, tcD=0, escN=0, escD=0, resN=0, resD=0, toneN=0, toneD=0, cohSum=0, cohCnt=0, tcallN=0, tcallD=0;\n\nfor (const p of preds) {\n  const sid = p.shipment_id;\n\n  const predExc = String(p.is_exception || '').toUpperCase();\n  const predRes = p.resolution || 'N/A';\n  const predTone = p.tone_label || 'N/A';\n  const predEsc = p.escalated === true || String(p.escalated).toLowerCase() === 'true';\n\n  // ground truth — must arrive under these gt_ prefixed keys without collision\n  const gtExc = String(p.gt_is_exception || '').toUpperCase();\n  const gtRes = p.gt_resolution || 'N/A';\n  const gtTone = p.gt_tone || 'N/A';\n  const gtEsc = p.gt_should_escalate; // 'YES' / 'NO'\n\n  const exc_match = predExc === gtExc;\n  const res_match = (gtExc === 'NO') ? (predRes === 'N/A') : (predRes === gtRes);\n  const tone_match = (gtExc === 'NO') ? (predTone === 'N/A' || predTone === '') : (predTone === gtTone);\n\n  let esc_match = null;\n  if (gtEsc === 'YES' || gtEsc === 'NO') {\n    esc_match = predEsc === (gtEsc === 'YES');\n    escD++; if (esc_match) escN++;\n  }\n\n  // --- tool-call accuracy (notebook logic) ---\n  const tools = Array.isArray(p.tools_used) ? p.tools_used : [];\n  let tool_match;\n  if (tools.length === 0) {\n    tool_match = true; // noise/guardrail: nothing should run\n  } else {\n    const required = ['Tool_customer_profile_lookup','Tool_locker_availability','check_escalation_rules','resolution_agent'];\n    if (gtExc === 'YES') required.push('communication_agent');\n    let ok = required.every(t => tools.includes(t));\n    if (gtExc === 'NO') ok = ok && !tools.includes('communication_agent');\n    tool_match = ok;\n  }\n  tcallD++; if (tool_match) tcallN++;\n\n  const task_complete = exc_match && res_match && tone_match;\n  tcD++; if (task_complete) tcN++;\n  resD++; if (res_match) resN++;\n  toneD++; if (tone_match) toneN++;\n\n  const coh = Number(p.coherence_score);\n  if (!isNaN(coh)) { cohSum += coh; cohCnt++; }\n\n  per.push({\n    shipment_id: sid,\n    is_exception: `${predExc} / ${gtExc}`,\n    resolution: `${predRes} / ${gtRes}`,\n    tone: `${predTone} / ${gtTone}`,\n    escalate: `${predEsc} / ${gtEsc}`,\n    tools_used: tools,\n    exc_match, res_match, tone_match, esc_match, tool_match,\n    task_complete,\n    coherence: isNaN(coh) ? null : coh,\n  });\n}\n\nconst pct = (n,d) => d ? Math.round((n/d)*1000)/10 : null;\nconst summary = {\n  n_shipments: preds.length,\n  task_completion_rate_pct: pct(tcN, tcD),\n  escalation_accuracy_pct: pct(escN, escD),\n  resolution_accuracy_pct: pct(resN, resD),\n  tone_accuracy_pct: pct(toneN, toneD),\n  tool_call_accuracy_pct: pct(tcallN, tcallD),\n  mean_coherence_1to5: cohCnt ? Math.round((cohSum/cohCnt)*100)/100 : null,\n};\n\nreturn [{ json: { summary, per_shipment: per } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
