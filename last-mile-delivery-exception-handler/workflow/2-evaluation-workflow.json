    {
      "parameters": {
        "jsonSchemaExample": "{ \n      \"shipment_id\":\"shp-002\",\n      \"coherence_score\": 5, \n      \"justification\": \"...\" \n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
