    {
      "parameters": {
        "jsCode": "// Build the canonical ground-truth row per shipment and the list of shipments to run.\n// Canonical = last row with is_exception === 'YES'; if none, the (last) NO row.\nconst rows = $input.all().map(i => i.json);\nconst byShip = {};\nfor (const r of rows) {\nconst sid = (r.shipment_id || '').trim();\nif (!sid) continue;\n(byShip[sid] = byShip[sid] || []).push(r);\n}\nconst out = [];\nfor (const sid of Object.keys(byShip)) {\nconst grp = byShip[sid];\nconst yes = grp.filter(r => String(r.is_exception).toUpperCase() === 'YES');\nconst canonical = yes.length ? yes[yes.length - 1] : grp[grp.length - 1];\nout.push({ json: {\ntarget_shipment_id: sid,\ngt_is_exception: String(canonical.is_exception || '').toUpperCase(),\ngt_resolution: canonical.expected_resolution,\ngt_tone: canonical.expected_tone,\ngt_should_escalate: String(canonical.should_escalate || '').toUpperCase(),\n}});\n}\nreturn out;"
      },
