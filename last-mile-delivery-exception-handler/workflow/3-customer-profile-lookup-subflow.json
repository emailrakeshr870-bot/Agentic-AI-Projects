        "command": "=CUSTOMER_ID=\"{{ $json.customer_id }}\" python3 << 'PYEOF'\nimport sqlite3, json, os\ncustomer_id = os.environ.get(\"CUSTOMER_ID\", \"\").strip()\nif not customer_id:\n  print(json.dumps({\"error\": \"customer_id is required\"}))\nelse:\n  conn = sqlite3.connect(\"/data/shared/customers.db\")\n  conn.row_factory = sqlite3.Row\n  c = conn.cursor()\n  c.execute(\"SELECT * FROM customers WHERE customer_id = ?\", (customer_id,))\n  row = c.fetchone()\n  conn.close()\n\nif row is None:\n  print(json.dumps({\"error\": \"customer not found\", \"customer_id\": customer_id}))\nelse:\n  print(json.dumps(dict(row)))\n\nPYEOF"
      },
