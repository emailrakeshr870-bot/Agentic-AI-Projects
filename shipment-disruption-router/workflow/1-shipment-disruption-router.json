    {
      "parameters": {
        "jsCode": "// n8n Code Node — Evaluation Metrics Calculator\n// Input: array of test case items from previous node\n// Each item should have: order_id, tool_used, resolution_decision,\n//   gt_decision, policy_citations, gt_policies, coherence_score\n\nconst items = $input.all();\n\n// ─── helpers ───────────────────────────────────────────────────────────────\n\n/**\n * Parse the tool_used field.\n * Accepts a JSON string like '[\"search_playbook\",\"Simple_Vector_Store\"]'\n * or an array already.\n */\nfunction parseTools(raw) {\n  if (Array.isArray(raw)) return raw;\n  try { return JSON.parse(raw); } catch { return []; }\n}\n\n/**\n * Parse policy_citations field.\n * Accepts either:\n *   - an object  { \"0\": \"POL-004\", \"1\": \"POL-002\" }\n *   - a string   '{\"0\":\"POL-004\",\"1\":\"POL-002\"}'\n *   - an array   [\"POL-004\", \"POL-002\"]\n * Returns a flat array of policy IDs.\n */\nfunction parseCitations(raw) {\n  if (!raw) return [];\n  let obj = raw;\n  if (typeof raw === \"string\") {\n    try { obj = JSON.parse(raw); } catch { return []; }\n  }\n  if (Array.isArray(obj)) return obj.map(String);\n  if (typeof obj === \"object\") return Object.values(obj).map(String);\n  return [];\n}\n\n/**\n * Parse gt_policies field.\n * Accepts a pipe-separated string \"POL-002|POL-006\", a plain string \"POL-004\",\n * or an array.\n * Returns a flat array of policy IDs.\n */\nfunction parseGtPolicies(raw) {\n  if (!raw) return [];\n  if (Array.isArray(raw)) return raw.map(String);\n  return String(raw).split(\"|\").map(s => s.trim()).filter(Boolean);\n}\n\n// Expected tools that indicate tool usage (adjust if needed)\nconst EXPECTED_TOOLS = [\"search_playbook\", \"Simple_Vector_Store\"];\n\n// ─── per-case metrics ───────────────────────────────────────────────────────\n\nconst results = items.map(item => {\n  const d = item.json;\n\n  const resolution   = String(d.resolution_decision || \"\").trim().toLowerCase();\n  const gtDecision   = String(d.gt_decision || \"\").trim().toLowerCase();\n  const coherence    = parseFloat(d.coherence_score) || 0;\n  const tools        = parseTools(d.tool_used);\n  const citations    = parseCitations(d.policy_citations);\n  const gtPolicies   = parseGtPolicies(d.gt_policies);\n\n  // 1. Decision match (1 = correct, 0 = wrong)\n  const decisionMatch = resolution === gtDecision ? 1 : 0;\n\n  // 2. Escalation accuracy\n  //    Correct if BOTH resolution AND gt_decision are \"escalate_human\",\n  //    or NEITHER is \"escalate_human\"\n  const resEscalated = resolution === \"escalate_human\";\n  const gtEscalated  = gtDecision  === \"escalate_human\";\n  const escalationMatch = resEscalated === gtEscalated ? 1 : 0;\n\n  // 3. Policy citation recall\n  //    How many of the ground-truth policies were cited?\n  let citationRecall = 0;\n  if (gtPolicies.length > 0) {\n    const hits = gtPolicies.filter(p => citations.includes(p)).length;\n    citationRecall = hits / gtPolicies.length;\n  }\n\n  // 4. Policy exact match\n  //    1 only if the cited set exactly equals the gt set (order-insensitive)\n  const exactMatch =\n    gtPolicies.length === citations.length &&\n    gtPolicies.every(p => citations.includes(p)) &&\n    citations.every(p => gtPolicies.includes(p))\n      ? 1 : 0;\n\n  // 5. Task completion\n  //    1 if a resolution_decision was produced and is non-empty\n  const taskComplete = resolution.length > 0 ? 1 : 0;\n\n  // 6. Tool accuracy\n  //    1 if AT LEAST ONE expected tool was used\n  const toolAccuracy = EXPECTED_TOOLS.some(t => tools.includes(t)) ? 1 : 0;\n\n  return {\n    order_id:         d.order_id,\n    decisionMatch,\n    escalationMatch,\n    citationRecall,\n    exactMatch,\n    coherence,        // already on 0–1 scale; multiply ×5 below for 1–5\n    taskComplete,\n    toolAccuracy,\n  };\n});\n\n// ─── aggregate metrics ──────────────────────────────────────────────────────\n\nconst n = results.length;\n\nfunction pct(arr, key) {\n  return n === 0 ? 0 : (arr.reduce((s, r) => s + r[key], 0) / n) * 100;\n}\n\nfunction avg(arr, key) {\n  return n === 0 ? 0 : arr.reduce((s, r) => s + r[key], 0) / n;\n}\n\nconst metrics = {\n  // Percentage of cases where resolution_decision === gt_decision\n  decision_accuracy_pct: parseFloat(pct(results, \"decisionMatch\").toFixed(2)),\n\n  // Percentage of cases where escalation status matches\n  escalation_accuracy_pct: parseFloat(pct(results, \"escalationMatch\").toFixed(2)),\n\n  // Average % of ground-truth policies that appear in citations\n  policy_citation_recall_pct: parseFloat((avg(results, \"citationRecall\") * 100).toFixed(2)),\n\n  // Percentage of cases with exactly-matching policy sets\n  policy_exact_match_pct: parseFloat(pct(results, \"exactMatch\").toFixed(2)),\n\n  // Mean coherence score scaled to 1–5\n  mean_coherence_1to5: parseFloat((avg(results, \"coherence\") * 5).toFixed(3)),\n\n  // Percentage of cases where a decision was produced\n  task_completion: parseFloat(pct(results, \"taskComplete\").toFixed(2)),\n\n  // Percentage of cases where at least one expected tool was used\n  tool_accuracy: parseFloat(pct(results, \"toolAccuracy\").toFixed(2)),\n\n  // Meta\n  total_cases: n,\n};\n\n// ─── output ─────────────────────────────────────────────────────────────────\n// Returns one item with the aggregated metrics\n// (plus per-case breakdown in case_results for debugging)\n\nreturn [\n  {\n    json: {\n      ...metrics,\n      case_results: results,\n    },\n  },\n];"
      },
