        "jsCode": "const rows = $input.all().map(x => x.json);\nconst byId = {};\nfor (const r of rows) {\n  const id = String(r['Order Id'] || '').trim();\n  if (!id) continue;\n  byId[id] = r;\n}\nconst out = [];\nfor (const id of Object.keys(byId)) {\n  const r = byId[id];\n  out.push({\n    json: {\n      target_order_id: id,\n      gt_decision: r['decision_expected'],\n      gt_policies: r['expected_policies']\n    }\n  });\n}\nreturn out;"
